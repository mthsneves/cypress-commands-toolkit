# Logs de depuração e execução
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Compilação e Cobertura
dist/
build/
out/
coverage/
.nyc_output/
*.tsbuildinfo

# Caches de ferramentas e empacotadores
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
.cypress-cache/

# Editores e IDEs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
