{
  "name": "cypress-commands-toolkit",
  "version": "1.0.0",
  "description": "Cypress Commands Toolkit: comandos customizados de alta performance, resiliência de UI, geradores de dados matematicamente válidos, helpers de API e login concorrente.",
  "main": "index.js",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/mthsneves/cypress-commands-toolkit.git"
  },
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:qa": "cross-env CYPRESS_ENV=qa cypress run",
    "cy:run:staging": "cross-env CYPRESS_ENV=staging cypress run",
    "cy:run:prod": "cross-env CYPRESS_ENV=prod cypress run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cypress",
    "cypress-commands",
    "typescript",
    "automation",
    "testing",
    "e2e",
    "resilience",
    "quality-assurance"
  ],
  "author": "Matheus Neves",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "cross-env": "^10.1.0",
    "cypress": "^16.2.0",
    "dotenv": "^18.0.8",
    "glob": "^13.0.6",
    "typescript": "^7.0.2"
  }
}
